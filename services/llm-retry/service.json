{
  "id": "llm-retry",
  "version": "1.0.0",
  "protocolVersion": "1.0.0",
  "entry": "node dist/index.js",
  "publishes": [
    "llm.metrics.usage",
    "llm.request"
  ],
  "subscribes": [
    "llm.provider.registered",
    "llm.provider.unregistered",
    "llm.request",
    "llm.request.failed",
    "llm.request.finished",
    "llm.request.started",
    "llm.token.streamed"
  ]
}

{
  "name": "@osteosome/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "共享 UI 组件库（P6）：宿主与插件 UI 共用同一份源码。纯展示组件 —— props 进、事件出，不自己发请求。",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/tokens.css": "./src/tokens.css",
    "./styles/base.css": "./src/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
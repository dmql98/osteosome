{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Osteosome 默认能力集：主窗口 + 插件管理外部窗口 + opener",
  "windows": ["main", "osteosome-plugin-list", "osteosome-plugin-detail-*", "osteosome-panel-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "core:window:allow-create"
    },
    {
      "identifier": "core:window:allow-set-focus"
    },
    {
      "identifier": "core:window:allow-close"
    },
    {
      "identifier": "core:window:allow-start-dragging"
    },
    {
      "identifier": "core:window:allow-minimize"
    },
    {
      "identifier": "core:window:allow-toggle-maximize"
    },
    {
      "identifier": "core:window:allow-is-maximized"
    },
    {
      "identifier": "core:webview:allow-create-webview-window"
    },
    {
      "identifier": "core:event:allow-emit-to"
    }
  ]
}

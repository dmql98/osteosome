{
  "name": "@osteosome/plugin-models-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "models 插件的 WebUI（P5）：模型设置整片。构建产物在 plugins/models/dist/ui/，由 Core 伺服在 /plugins/models/ui/",
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@osteosome/core-client": "workspace:*",
    "@osteosome/shared": "workspace:*",
    "@osteosome/ui": "workspace:*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}

{
  "name": "@osteosome/plugin-workbench-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "workbench 插件的 WebUI（P6）：系统信息 / 命令台 / 设置 / 事件流 / 服务管理 / 服务状态，六个命名视图共用一份 bundle。产物在 plugins/workbench/dist/ui/",
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@osteosome/core-client": "workspace:*",
    "@osteosome/ui": "workspace:*",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
